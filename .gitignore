# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are intentionally unanchored — the Next.js app lives in frontend/,
# so a leading "/" would stop them matching.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
.pytest_cache/

# python (backend)
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# backend runtime artifacts
backend/debug_extraction.txt
backend/logs/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env*
# ...but the templates must be committed, or nobody can set the project up.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
