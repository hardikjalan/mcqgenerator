# backend/.env — server-side only. Never committed; copy this file to .env.
#
# Every value here is optional. With none of them set the API runs, extracts
# PDF/DOCX/PPTX/DOC/PPT, and refuses images with a clear message.

# Comma-separated origins allowed to call this API. The browser blocks every
# request from an origin not named here, and it surfaces as a generic network
# error rather than a CORS one — so add your Vercel URL on deploy.
ALLOWED_ORIGINS=http://localhost:3000

# ── Gemini (optional) ─────────────────────────────────────────────────────────
# One key powers two things: OCR (reading images and scanned PDFs) and
# embeddings (making uploads searchable). Without it, files are still read and
# chunked — they just are not indexed, and images are refused.
#
# Both are free on Google's unpaid quota. Be aware that under Google's API
# terms, content sent on the unpaid quota is used to improve Google's products
# and may be read by human reviewers; content on the paid quota is not.
# Uploaded course material goes through this key. Enabling billing on the same
# key changes the terms with no code change.
# GEMINI_API_KEY=

# Vision model used for OCR. Model names expire — gemini-2.0-flash was the
# default here until Google shut it down. Check the current model list if OCR
# starts failing.
# GEMINI_OCR_MODEL=gemini-2.5-flash-lite

# Ceiling on OCR calls per document. A 300-page scanned book would otherwise
# issue 300 paid vision requests from one upload.
# MAX_OCR_PAGES_PER_DOC=20

# A PDF page with fewer than this many characters in its text layer is treated
# as a scan. Not zero — scanners often stamp a page number into the layer.
# OCR_TEXT_LAYER_THRESHOLD=32

# Resolution for rendering a PDF page before OCR. 200 is the usual floor for
# reliable recognition of body text.
# OCR_RENDER_DPI=200

# ── Embeddings (optional) ─────────────────────────────────────────────────────
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Vector width. A float is 4 bytes, so 3072 dimensions is 12KB per chunk and
# 768 is 3KB — four times as many documents inside Supabase's free 500MB.
# This value is baked into the database column (see migration 07), so changing
# it means changing the migration AND re-embedding everything.
# EMBED_DIMENSIONS=768

# EMBED_BATCH_SIZE=32
# EMBED_MAX_RETRIES=3

# ── Supabase (optional, but see the warning) ──────────────────────────────────
# Used for two things: storing embedded chunks, and verifying who is calling.
# Run supabase/migrations/07_chunks.sql and 08_ownership_hardening.sql first.
#
# IMPORTANT: setting SUPABASE_URL turns on authentication. Every request must
# then carry a signed-in user's token, and uploads, indexing and search are
# scoped to that user. Leaving it unset means the API is open — fine on your
# own machine, never on anything a second person can reach.
#
# The service-role key bypasses row-level security. It must never reach the
# browser. Find both under Project Settings → API in Supabase.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# How long a verified token is trusted before Supabase is asked again.
# AUTH_CACHE_SECONDS=60

# ── Retrieval ─────────────────────────────────────────────────────────────────
# How many chunks a search returns.
# RETRIEVAL_TOP_K=8

# Cosine similarity below this is not a match, it is the closest of a bad set.
# Without a floor, a question about a topic absent from the material still
# returns the least-irrelevant chunks and the model writes questions from them.
# RETRIEVAL_MIN_SCORE=0.35

# ── Chunking ──────────────────────────────────────────────────────────────────
# Sizes are in words, not tokens. 300 words is roughly 400 tokens.
# CHUNK_SIZE_WORDS=300
# CHUNK_OVERLAP_WORDS=50
# MIN_MERGE_WORDS=80
# MIN_CHUNK_WORDS=25

# ── Question generation ───────────────────────────────────────────────────────
# Uses GEMINI_API_KEY. Without it files are read, chunked and indexed but no
# quiz is written.
# GEMINI_GENERATION_MODEL=gemini-2.5-flash

# Low but not zero: reproducible enough to debug, varied enough that four
# questions on one topic are not four rephrasings.
# GENERATION_TEMPERATURE=0.4

# Questions per model call. Asking for forty at once produces visibly worse
# questions towards the end, and one refusal loses the whole batch.
# GENERATION_BATCH_SIZE=5

# Passages shown to the model per batch. More context is not better — it
# starts writing from whatever is most quotable rather than what was asked.
# GENERATION_CONTEXT_CHUNKS=6

# Ceiling per request, whatever the quiz config asks for.
# MAX_QUESTIONS=30
