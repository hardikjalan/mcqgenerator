# Copy to frontend/.env.local. These values are public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the project's publishable key (or legacy anon key), never its service key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternatively replace the preceding line with NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_API_URL=http://localhost:8000
