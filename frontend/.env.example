# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# Everything here is compiled into the browser bundle and is publicly readable.
# Server-side secrets (the Gemini key) belong in backend/.env, never here.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API. The URL is the project URL, not the REST endpoint.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Backend ───────────────────────────────────────────────────────────────────
# Where the FastAPI app is reachable. Optional in local development, where it
# defaults to http://localhost:8000. Required for any deployed build — set it
# to the real backend address, e.g. https://cognira-api.onrender.com
#
# Remember to add the deployed frontend address to ALLOWED_ORIGINS in
# backend/app/core/config.py, or the browser will block the request.
NEXT_PUBLIC_API_URL=
